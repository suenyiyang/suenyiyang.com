                      "content": "Building an AI Agent\nFramework from Scratch",
                      "lineHeight": 1.15,
                      "textAlign": "center",
                      "fontFamily": "Playfair Display",
                      "fontSize": 48,
                      "fontWeight": "normal",
                      "letterSpacing": -1,
                      "fontStyle": "italic"
                    },
                    {
                      "type": "frame",
                      "id": "5Razs",
                      "name": "articleTagRow",
                      "gap": 8,
                      "children": [
                        {
                          "type": "frame",
                          "id": "MYmqN",
                          "name": "articleTag1",
                          "stroke": {
                            "thickness": 1,
                            "fill": "#E5E2DC"

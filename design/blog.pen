                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "ed4ka",
                          "name": "talk2Content",
                          "fill": "#444444",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Hot take: Most \"design systems\" are just component libraries with fancy documentation. A real design system includes decision frameworks, not just buttons and inputs.",

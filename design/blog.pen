                                  "content": "AI Agent",
                                  "fontFamily": "IBM Plex Mono",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "OH6PV",
                              "name": "tag2",
                              "stroke": {
                                "thickness": 1,
                                "fill": "#E5E2DC"

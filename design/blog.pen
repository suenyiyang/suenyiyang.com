                      "fontWeight": "normal",
                      "letterSpacing": -1,
                      "fontStyle": "italic"
                    },
                    {
                      "type": "frame",
                      "id": "96iq4",
                      "name": "articleTagRow",
                      "gap": 8,
                      "children": [
                        {
                          "type": "frame",

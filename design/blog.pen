                          "padding": [
                            4,
                            10
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "d73Eu",
                              "name": "articleTag1Text",
                              "fill": "#666666",
                              "content": "AI Agent",
                              "fontFamily": "IBM Plex Mono",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "PnvGG",
                          "name": "articleTag2",
                          "stroke": {
                            "thickness": 1,
                            "fill": "#E5E2DC"

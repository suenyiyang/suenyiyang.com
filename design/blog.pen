                              "fontFamily": "IBM Plex Mono",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Mf9fx",
                          "name": "articleTag2",
                          "stroke": {
                            "thickness": 1,
                            "fill": "#2A2A2A"

                          "name": "bioPara2",
                          "fill": "#B0B0B0",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "I believe great software lies at the intersection of thoughtful design and clean engineering. This blog is where I document my learnings, share tutorials, and occasionally ramble about the tools I love.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },

# HSTS is set here because Pages reads this file.
# HTTP→HTTPS cannot be expressed in _headers or _redirects; enable
# "Always Use HTTPS" in the Cloudflare dashboard (SSL/TLS → Edge Certificates).
/*
  Strict-Transport-Security: max-age=31536000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/logo.webp
  Cache-Control: public, max-age=86400

/og.jpg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/icon-192.webp
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
